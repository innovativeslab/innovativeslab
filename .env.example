# --- Required ---
# Postgres connection string (Neon / Supabase / any managed Postgres). Use the pooled URL on serverless hosts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Random 32+ character secret. Generate: openssl rand -base64 48
AUTH_SECRET=""
# Public site URL, no trailing slash (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://example.com"

# --- Lead notifications (leads are still saved if these are missing) ---
RESEND_API_KEY=""
EMAIL_FROM="Innovations Labs <notifications@your-verified-domain.com>"
LEAD_NOTIFY_EMAIL=""

# --- Optional public settings (nothing is displayed if left empty) ---
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_GITHUB_URL=""
# Booking link (Cal.com / Calendly). If empty, the consultation request form is used.
NEXT_PUBLIC_BOOKING_URL=""
# Google Analytics 4 measurement ID. Loaded ONLY after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=""
# Set to "true" once a lawyer has reviewed the legal pages (hides the draft banner)
NEXT_PUBLIC_LEGAL_REVIEWED="false"
